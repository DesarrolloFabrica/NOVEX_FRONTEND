# API backend. En local se deja vacía para usar el proxy de Vite hacia :3001.
# En producción es obligatoria y debe incluir /api/v1.
VITE_API_BASE_URL=
VITE_API_URL=

# Google OAuth.
VITE_GOOGLE_CLIENT_ID=

# Solo desarrollo local; en otros entornos debe permanecer en false.
VITE_ENABLE_EMAIL_LOGIN=false

# Metadatos opcionales usados por el pipeline de despliegue.
VITE_APP_NAME=NOVEX
VITE_APP_ENV=development
