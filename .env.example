# API backend. VITE_API_URL se mantiene como alias de compatibilidad.
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_API_URL=

# Google OAuth.
VITE_GOOGLE_CLIENT_ID=

# Solo desarrollo local; en otros entornos debe permanecer en false.
VITE_ENABLE_EMAIL_LOGIN=false

# Metadatos opcionales usados por el pipeline de despliegue.
VITE_APP_NAME=NOVEX
VITE_APP_ENV=development
